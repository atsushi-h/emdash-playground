{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "ミナトテック",
		"description": "株式会社ミナトテック 企業サイトPoC",
		"author": "EmDash"
	},
	"settings": {
		"title": "株式会社ミナトテック",
		"tagline": "精密部品加工・機械設計を通じて、ものづくりを支えます。",
		"timezone": "Asia/Tokyo"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "お知らせ",
			"labelSingular": "お知らせ",
			"urlPattern": "/news/{slug}/",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "タイトル",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "メイン画像",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "本文",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "概要",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "general",
					"label": "General"
				},
				{
					"slug": "updates",
					"label": "Updates"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "starter",
					"label": "Starter"
				},
				{
					"slug": "example",
					"label": "Example"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "メインメニュー",
			"items": [
				{
					"type": "custom",
					"label": "ホーム",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "お知らせ",
					"url": "/news/"
				},
				{
					"type": "custom",
					"label": "会社概要",
					"url": "/about/"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5
					}
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "会社概要",
					"content": [
						{
							"_type": "block",
							"_key": "about",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "text",
									"text": "株式会社ミナトテック（架空企業）｜事業内容：精密部品加工・機械設計｜従業員数：約35名"
								}
							]
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-1",
				"slug": "welcome",
				"status": "published",
				"data": {
					"title": "ホームページを公開しました",
					"excerpt": "株式会社ミナトテックからのお知らせを掲載します。",
					"content": [
						{
							"_type": "block",
							"_key": "welcome",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "text",
									"text": "株式会社ミナトテックは、精密部品加工・機械設計に取り組む約35名の会社です。このサイトは架空企業のPoCです。"
								}
							]
						}
					]
				},
				"taxonomies": {
					"category": ["general"],
					"tag": ["starter", "example"]
				}
			}
		]
	}
}
