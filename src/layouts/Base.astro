---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ContactCTA from "../components/ContactCTA.astro";
import "../styles/theme.css";

interface Props {
	title: string;
	isPreview?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	showContactCTA?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	isPreview = false,
	publishedTime,
	modifiedTime,
	showContactCTA = true,
} = Astro.props;
const privatePage = isPreview || Astro.url.searchParams.has("_preview");
if (privatePage) {
	Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
	Astro.response.headers.set("Cache-Control", "private, no-store");
}
const [settingsResult, menuResult, footerResult, companyResult] = Astro.locals.corporateChrome!;
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(footerResult.cacheHint);
	Astro.cache.set(companyResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(settingsResult.data);
const separator = settingsResult.data.seo?.titleSeparator ?? " — ";
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(`${separator}${siteTitle}`) ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title}${separator}${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: content ? "article" : "website",
	seo: privatePage ? { robots: "noindex, nofollow" } : undefined,
	articleMeta: content ? { publishedTime, modifiedTime } : undefined,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<a class="skip-link" href="#main-content">
			本文へスキップ
		</a>
		<SiteHeader siteTitle={siteTitle} siteLogo={siteLogo} menu={menu} />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		{showContactCTA && <ContactCTA />}
		<SiteFooter
			siteTitle={siteTitle}
			company={companyResult.entry?.data}
			menu={footerResult.data}
		/>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
