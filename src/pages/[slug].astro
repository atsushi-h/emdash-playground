---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettingsWithCacheHint } from "emdash";
import { PortableText } from "emdash/ui";
import { contentUnavailable } from "../utils/news";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint, error, isPreview } = await getEmDashEntry("pages", slug);

if (error) return contentUnavailable();
if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const settings = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settings.cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(settings.data);

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/${encodeURIComponent(page.id)}/`,
});
---

<Base
	isPreview={isPreview}
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article>
		<h1 {...page.edit.title}>{page.data.title}</h1>

		<PortableText value={page.data.content} />
	</article>
</Base>
