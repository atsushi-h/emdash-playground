---
import { getEmDashEntry, decodeSlug } from "emdash";
import CorporatePage from "../components/CorporatePage.astro";
import { slashRedirect } from "../utils/corporate";
import { contentUnavailable, protectPreview } from "../utils/news";

if (!Astro.url.pathname.endsWith("/")) return Astro.redirect(slashRedirect(Astro.url), 308);
const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const result = await getEmDashEntry("pages", slug).catch(() => null);
if (!result) return contentUnavailable();
const { entry: page, cacheHint, error } = result;

if (error) return contentUnavailable();
if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
protectPreview(Astro.response, Astro.url, result.isPreview);
---

<CorporatePage result={result} slug={slug} />
