---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { newsPath, formatNewsDate, contentUnavailable } from "../../utils/news";

if (!Astro.url.pathname.endsWith("/")) {
	const target = new URL(Astro.url);
	target.pathname += "/";
	return Astro.redirect(target.pathname + target.search, 308);
}
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const result = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
}).catch(() => null);
if (!result || result.error) return contentUnavailable();
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const { entries: posts, nextCursor } = result;
const canonical = new URL("/news/", Astro.url.origin);
if (cursor) canonical.searchParams.set("cursor", cursor);
---

<Base
	title="お知らせ"
	description="株式会社ミナトテックからのお知らせをご案内します。"
	canonical={canonical.href}
>
	<h1>お知らせ</h1>
	{posts.length === 0 ? (
		<p>現在、お知らせはありません。</p>
	) : (
		<ul class="news-list">
			{posts.map((post) => (
				<li>
					<a href={newsPath(post.id)}>
						{post.data.featured_image && <Image image={post.data.featured_image} />}
						<h2>{post.data.title}</h2>
					</a>
					{post.data.publishedAt && (
						<time datetime={post.data.publishedAt.toISOString()}>
							{formatNewsDate(post.data.publishedAt)}
						</time>
					)}
					{post.data.excerpt && <p>{post.data.excerpt}</p>}
				</li>
			))}
		</ul>
	)}
	<nav aria-label="ページ送り">
		{cursor && <a href="/news/">最初のページ</a>}
		{nextCursor && <a href={`/news/?cursor=${encodeURIComponent(nextCursor)}`}>次のページ</a>}
	</nav>
</Base>
