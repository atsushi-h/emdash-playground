---
import { getEmDashCollection } from "emdash";
import NewsList from "../../components/NewsList.astro";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { contentUnavailable, protectPreview } from "../../utils/news";

if (!Astro.url.pathname.endsWith("/")) {
	const target = new URL(Astro.url);
	target.pathname += "/";
	return Astro.redirect(target.pathname + target.search, 308);
}
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const result = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
}).catch(() => null);
if (!result || result.error) return contentUnavailable();
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const { entries: posts, nextCursor } = result;
const canonical = new URL("/news/", Astro.url.origin);
if (cursor) canonical.searchParams.set("cursor", cursor);
protectPreview(Astro.response, Astro.url, false);
---

<Base
	title="お知らせ"
	description="株式会社ミナトテックからのお知らせをご案内します。"
	canonical={canonical.href}
>
	<PageHeader
		title="お知らせ"
		eyebrow="NEWS"
		lead="ミナトテックの取り組みやご案内をお届けします。"
	/>
	<Breadcrumbs items={[{ label: "お知らせ" }]} />
	<div class="container section">
		<NewsList posts={posts} images />
		<nav class="pagination" aria-label="ページ送り">
			{cursor && <a href="/news/">最初のページ</a>}
			{nextCursor && <a href={`/news/?cursor=${encodeURIComponent(nextCursor)}`}>次のページ</a>}
		</nav>
	</div>
</Base>
