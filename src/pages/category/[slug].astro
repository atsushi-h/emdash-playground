---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import { Image } from "emdash/ui";
import { newsPath, contentUnavailable } from "../../utils/news";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	error,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	status: "published",
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (error) return contentUnavailable();
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`${term.label}のお知らせ`} description={`${term.label}のお知らせ`}>
	<h1>{term.label}</h1>

	{posts.length === 0 ? (
		<p>このカテゴリのお知らせはありません。</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={newsPath(post.id)}>
						{post.data.featured_image && (
							<div {...post.edit.featured_image}>
								<Image image={post.data.featured_image} />
							</div>
						)}
						<h2 {...post.edit.title}>{post.data.title}</h2>
					</a>
					{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
				</li>
			))}
		</ul>
	)}
	<nav aria-label="ページ送り">
		{cursor && <a href={`/category/${term.slug}`}>最初のページ</a>}
		{nextCursor && (
			<a href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>次のページ</a>
		)}
	</nav>
</Base>
