---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import WorkCard from "../../components/works/WorkCard.astro";
import { contentUnavailable, protectPreview } from "../../utils/news";

if (!Astro.url.pathname.endsWith("/")) {
	const target = new URL(Astro.url);
	target.pathname += "/";
	return Astro.redirect(target.pathname + target.search, 308);
}
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const result = await getEmDashCollection("works", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
}).catch(() => null);
if (!result || result.error) return contentUnavailable();
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const canonical = new URL("/works/", Astro.url.origin);
if (cursor) canonical.searchParams.set("cursor", cursor);
protectPreview(Astro.response, Astro.url, false);
---

<Base
	title="製作実績"
	description="株式会社ミナトテックの製作実績をご紹介します。掲載事例は架空のPoC用コンテンツです。"
	canonical={canonical.href}
>
	<PageHeader
		title="製作実績"
		eyebrow="WORKS"
		lead="加工と設計の取り組みを、架空の製作例でご紹介します。"
	/>
	<Breadcrumbs items={[{ label: "製作実績" }]} />
	<div class="container section">
		<p>掲載事例は架空の製作例です。画像は実物写真ではなく模式図です。</p>
		{result.entries.length === 0 ? (
			<p>現在、公開している製作実績はありません。</p>
		) : (
			<ul class="card-grid">
				{result.entries.map((work) => (
					<li>
						<WorkCard slug={work.id} work={work.data} />
					</li>
				))}
			</ul>
		)}
		<nav class="pagination" aria-label="製作実績のページ送り">
			{cursor && <a href="/works/">最初のページ</a>}
			{result.nextCursor && (
				<a href={`/works/?cursor=${encodeURIComponent(result.nextCursor)}`}>次のページ</a>
			)}
		</nav>
	</div>
</Base>
