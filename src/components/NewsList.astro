---
import type { Post } from "../../emdash-env";
import { Image } from "emdash/ui";
import { newsPath, formatNewsDate } from "../utils/news";
interface Props {
	headingLevel?: "h2" | "h3";
	posts: { id: string; data: Post }[];
	images?: boolean;
}
const { posts, images = false, headingLevel: Heading = "h2" } = Astro.props;
---

{posts.length === 0 ? (
	<p class="notice">現在、公開しているお知らせはありません。</p>
) : (
	<ul class="news-list">
		{posts.map((post) => (
			<li>
				{images && post.data.featured_image && (
					<a class="news-image" href={newsPath(post.id)} tabindex="-1" aria-hidden="true">
						<Image image={post.data.featured_image} />
					</a>
				)}
				<div class="news-copy">
					<p class="muted">
						{post.data.publishedAt && (
							<time datetime={post.data.publishedAt.toISOString()}>
								{formatNewsDate(post.data.publishedAt)}
							</time>
						)}
						<span class="news-label">お知らせ</span>
					</p>
					<Heading class="card-heading">
						<a href={newsPath(post.id)}>{post.data.title}</a>
					</Heading>
					{images && post.data.excerpt && <p>{post.data.excerpt}</p>}
				</div>
			</li>
		))}
	</ul>
)}
<style>
	.news-list {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--color-border);
	}
	li {
		display: flex;
		gap: var(--space-4);
		padding-block: var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}
	.news-copy {
		min-width: 0;
		flex: 1;
	}
	.muted {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-bottom: var(--space-2);
	}
	.news-label {
		color: var(--color-accent);
	}
	.card-heading {
		font-size: var(--text-lead);
		margin: 0;
	}
	.card-heading a {
		color: var(--color-primary);
	}
	p:last-child {
		margin-bottom: 0;
	}
	.news-image {
		width: 8rem;
		flex-shrink: 0;
	}
	.news-image :global(img) {
		width: 100%;
		border-radius: var(--radius-card);
	}
	@media (max-width: 40rem) {
		.news-image {
			width: 4.5rem;
		}
	}
</style>
