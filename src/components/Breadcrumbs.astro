---
interface Props {
	items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs container" aria-label="パンくず">
	<ol>
		<li>
			<a href="/">ホーム</a>
		</li>
		{items.map((item) => (
			<li>
				{item.href ? (
					<a href={item.href}>{item.label}</a>
				) : (
					<span aria-current="page">{item.label}</span>
				)}
			</li>
		))}
	</ol>
</nav>
<style>
	.breadcrumbs {
		padding-block: var(--space-4);
		font-size: var(--text-small);
		color: var(--color-muted);
	}
	ol {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li + li::before {
		content: "/";
		margin-right: var(--space-2);
		color: var(--color-muted);
	}
</style>
