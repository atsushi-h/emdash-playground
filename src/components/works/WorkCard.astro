---
import type { Work } from "../../../emdash-env";
import { Image } from "emdash/ui";
import { worksPath, formatWorkDate } from "../../utils/works";
interface Props {
	headingLevel?: "h2" | "h3";
	slug: string;
	work: Work;
}
const { slug, work, headingLevel: Heading = "h2" } = Astro.props;
---

<article class="card">
	<a href={worksPath(slug)} class="card-media" tabindex="-1" aria-hidden="true">
		{work.featured_image ? (
			<Image image={work.featured_image} />
		) : (
			<span class="card-placeholder">MINATOTECH / WORKS</span>
		)}
	</a>
	<div class="card-body">
		<p class="eyebrow">架空製作例・模式図</p>
		<Heading class="card-heading">
			<a href={worksPath(slug)}>{work.title}</a>
		</Heading>
		<p>{work.summary}</p>
		{work.publishedAt && (
			<p class="muted">
				公開日：
				<time datetime={work.publishedAt.toISOString()}>{formatWorkDate(work.publishedAt)}</time>
			</p>
		)}
	</div>
</article>
