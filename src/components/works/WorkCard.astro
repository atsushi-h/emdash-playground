---
import type { Work } from "../../../emdash-env";
import { Image } from "emdash/ui";
import { worksPath, formatWorkDate } from "../../utils/works";

interface Props {
	slug: string;
	work: Work;
}
const { slug, work } = Astro.props;
---

<article>
	<a href={worksPath(slug)}>
		{work.featured_image && <Image image={work.featured_image} />}
		<h2>{work.title}</h2>
	</a>
	<p>{work.summary}</p>
	{work.publishedAt && (
		<p>
			公開日：
			<time datetime={work.publishedAt.toISOString()}>{formatWorkDate(work.publishedAt)}</time>
		</p>
	)}
</article>

<style>
	article {
		overflow-wrap: anywhere;
	}
	article :global(img) {
		max-width: 100%;
		height: auto;
	}
</style>
